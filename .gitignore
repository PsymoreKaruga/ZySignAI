# ================================
# ZySignAI — Master .gitignore
# ================================

# CRITICAL — API keys, never commit
backend/.env
backend/.env.local
backend/.env.production

# Python virtual environment
backend/dreams/
backend/venv/
backend/env/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Django
backend/db.sqlite3
backend/staticfiles/
backend/media/

# Next.js dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*

# Next.js build output
frontend/.next/
frontend/out/
frontend/build

# Next.js env files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/.env.production

# Vercel
frontend/.vercel

# TypeScript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Testing
frontend/coverage/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/
*.code-workspace

# Logs
*.log








